{
  "manifest_version": 3,
  "name": "SEMPER – Referencje OCR",
  "version": "0.3.17",
  "description": "OCR referencji SEMPER z klasyfikatorem 3.2, RRMMDD i kompaktowym formularzem: Aktywne, Sortowanie, Po zapisie, Nazwa oraz pełnowymiarowy podgląd oryginału.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Włącz lub wstrzymaj SEMPER – Referencje OCR",
    "default_popup": "popup/popup.html"
  },
  "host_permissions": [
    "https://www.szkolenia-semper.pl/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.szkolenia-semper.pl/wavepanel/ref.php*",
        "https://www.szkolenia-semper.pl/wavepanel/ref_adm.php*",
        "https://www.szkolenia-semper.pl/wavepanel/ref_kat.php*",
        "https://www.szkolenia-semper.pl/__template/img/upload/*"
      ],
      "js": [
        "page/page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.szkolenia-semper.pl/wavepanel/ref.php*",
        "https://www.szkolenia-semper.pl/wavepanel/ref_adm.php*",
        "https://www.szkolenia-semper.pl/wavepanel/ref_kat.php*",
        "https://www.szkolenia-semper.pl/__template/img/upload/*"
      ],
      "css": [
        "content/style.css"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
